# Copy to .env and edit. Everything here is optional — the defaults run the
# whole pipeline offline against the bundled synthetic fixtures.

# ---- data mode ----------------------------------------------------------
# offline = bundled fixtures only (no network, no keys)
# live    = network providers only
# auto    = live when credentials are present, otherwise offline   [default]
MINING_AGENT_DATA_MODE=auto
# MINING_AGENT_DATA_DIR=./data

# ---- agent --------------------------------------------------------------
# Without a key, the deterministic planner runs and still produces a briefing.
ANTHROPIC_API_KEY=
MINING_AGENT_MODEL=claude-opus-5
MINING_AGENT_EFFORT=high
MINING_AGENT_MAX_ITERATIONS=8
# Set to 0 to always use the deterministic planner.
MINING_AGENT_LLM=1

# ---- mining-news-mcp ----------------------------------------------------
# Set NEWS_API_KEY and the news server switches from the bundled corpus to
# newsapi.org automatically (provider=auto).
NEWS_API_KEY=
# MINING_AGENT_NEWS_PROVIDER=offline

# ---- mineral-pdf-mcp ----------------------------------------------------
# MINING_AGENT_PDF_PROVIDER=offline
MINING_AGENT_PDF_ALLOW_NETWORK=1
MINING_AGENT_PDF_MAX_BYTES=41943040

# ---- lme-price-mcp ------------------------------------------------------
# Point at a JSON price API to switch away from the fixture series.
# Expected: GET {base}/price?commodity=&date=  -> {"close":..,"date":..,"unit":..}
#           GET {base}/trend?commodity=&days=  -> {"points":[{"date":..,"close":..}]}
# MINING_AGENT_PRICE_PROVIDER=http
# MINING_AGENT_PRICE_BASE_URL=
# MINING_AGENT_PRICE_API_KEY=

# ---- MCP SSE transport (only used when MCP_TRANSPORT=sse) ----------------
# The SSE transport validates the Host header against an allow-list to block
# DNS rebinding, and accepts only localhost by default. Any other hostname
# (a docker service name, a LAN address) must be listed here or the request is
# rejected with 421 before the MCP handshake starts.
# MCP_ALLOWED_HOSTS=my-host:8001,localhost:8001
# MCP_ALLOWED_ORIGINS=
# Set to 0 to disable the check entirely (trusted networks only).
# MCP_DNS_REBINDING_PROTECTION=1

# ---- observability ------------------------------------------------------
MINING_AGENT_LOG_LEVEL=INFO
MINING_AGENT_LOG_JSON=0
# Server logs are discarded by the stdio transport by default; set a file to keep them.
# MINING_AGENT_LOG_FILE=./output/servers.log
# Set to 1 to let server stderr through to the agent's terminal (may mojibake on Windows).
# MINING_AGENT_MCP_STDERR=0
